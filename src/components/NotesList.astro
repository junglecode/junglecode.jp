---
// The latest notes as three editorial cards.
import { Picture } from 'astro:assets';
import { photos, focus, type PhotoKey } from './Photos';

interface NoteCard { title: string; excerpt: string; date: string; href: string; draft: boolean; photo: PhotoKey }
interface Props { id: string; label: string; title: string; notes: NoteCard[]; read: string; allNotes: { label: string; href: string }; draftLabel: string }
const { id, label, title, notes, allNotes, draftLabel } = Astro.props;
---
<section class="notes section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap notes-head" data-reveal>
    <div>
      <span class="label">{label}</span>
      <h2 id={`${id}-title`} class="h2">{title}</h2>
    </div>
    <a class="text-link" href={allNotes.href}>{allNotes.label} <span aria-hidden="true">→</span></a>
  </div>
  <ul class="wrap notes-grid">
    {notes.map((n) => (
      <li data-reveal>
        <a class="note-card" href={n.href}>
          <span class="note-photo"><Picture src={photos[n.photo]} alt="" formats={['avif', 'webp']} widths={[480, 720, 960]} sizes="(max-width: 52rem) 100vw, 30vw" style={`object-position:${focus[n.photo]}`} /></span>
          <span class="note-meta">{n.date}{n.draft && <span class="note-draft"> · {draftLabel}</span>}</span>
          <span class="note-title" lang="en">{n.title}</span>
          <span class="note-excerpt">{n.excerpt}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .notes-head { display: flex; justify-content: space-between; align-items: end; gap: 1rem 2rem; flex-wrap: wrap; }
  .notes-head > div { display: grid; gap: 1rem; }
  .notes-grid { margin-top: clamp(2.5rem, 5vw, 3.5rem); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem var(--gutter); }
  .note-card { display: grid; gap: 0.85rem; text-decoration: none; }
  .note-photo { display: block; overflow: hidden; }
  .note-photo :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; transition: transform 1.2s var(--ease); }
  .note-card:hover .note-photo :global(img) { transform: scale(1.04); }
  .note-meta { font-size: var(--step-small); color: var(--soft); }
  .note-draft { font-weight: 500; color: var(--ink); }
  .note-title { font-family: var(--font-display); font-size: var(--step-subtitle); line-height: 1.12; letter-spacing: -0.025em; text-wrap: balance; }
  .note-card:hover .note-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .note-excerpt { color: var(--soft); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 52rem) { .notes-grid { grid-template-columns: 1fr; } }
</style>
