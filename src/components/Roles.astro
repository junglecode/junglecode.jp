---
// Two fields that meet at a hard edge: what we lead, and what specialist partners lead.
// The wider field says which side we own without a badge.
interface Side { title: string; text: string; lines: string[] }
interface Props { id: string; title: string; we: Side; partners: Side }
const { id, title, we, partners } = Astro.props;
---
<section class="roles" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="wrap roles-title">{title}</h2>
  <div class="roles-fields">
    {[we, partners].map((side, i) => (
      <div class:list={['roles-field', i === 0 ? 'roles-field--we' : 'roles-field--partners']} data-reveal>
        <h3>{side.title}</h3>
        <p class="roles-text">{side.text}</p>
        <ul>{side.lines.map((l) => <li>{l}</li>)}</ul>
      </div>
    ))}
  </div>
</section>

<style>
  .roles { padding-top: var(--section); }
  .roles-title { font-size: var(--step-head); margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .roles-fields { display: grid; grid-template-columns: 7fr 5fr; }
  .roles-field { padding: clamp(2rem, 4vw, 3.5rem) var(--margin); min-height: 34rem; display: flex; flex-direction: column; }
  .roles-field--we { background: var(--sumi); color: var(--on-sumi); }
  .roles-field--partners { background: var(--paper-2); }
  .roles-field h3 { font-size: var(--step-head); line-height: 1; }
  :global(:root[lang='ja']) .roles-field h3 { line-height: 1.3; }
  .roles-text { margin-top: 1.25rem; font-family: var(--font-display); font-size: var(--step-lead); line-height: 1.25; max-width: 30ch; }
  .roles-field ul { margin-top: auto; padding-top: 2.5rem; display: grid; gap: 0.5rem; }
  .roles-field li { line-height: 1.45; }
  @media (max-width: 52rem) {
    .roles-fields { grid-template-columns: 1fr; gap: 3rem; }
    .roles-field { min-height: 0; }
  }
</style>
