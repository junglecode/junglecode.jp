---
import { Picture } from 'astro:assets';
import Seal from './Seal.astro';
import { plates, focus, type PlateKey } from './Plates';
import type { SiteCopy } from '../data/en';

interface Props {
  copy: SiteCopy;
  title: string;
  standfirst: string;
  vertical: string;
  plateList: { key: string; alt: string; caption: string }[];
  cards?: { title: string; href: string; plate: PlateKey; alt: string }[];
  action: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const { title, standfirst, vertical, plateList, cards = [], action, secondary } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="masthead" data-masthead>
    <div class="masthead-plates">
      {plateList.map((p, i) => (
        <figure class:list={['plate', { 'is-active': i === 0 }]} data-caption={p.caption}>
          <Picture
            src={plates[p.key as PlateKey]}
            alt={p.alt}
            formats={['avif', 'webp']}
            widths={[640, 960, 1440, 1920, 2560]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            style={`object-position:${focus[p.key as PlateKey]}`}
          />
        </figure>
      ))}
    </div>
    <p class="masthead-caption" data-masthead-caption>{plateList[0].caption}</p>
    {cards.length > 0 && (
      <ul class="masthead-cards">
        {cards.map((c) => (
          <li>
            <a class="corner-card" href={c.href}>
              <Picture src={plates[c.plate]} alt={c.alt} formats={['avif', 'webp']} widths={[320, 480]} sizes="(max-width: 40rem) 46vw, 15rem" style={`object-position:${focus[c.plate]}`} />
              <span class="corner-card-bar"><span>{c.title}</span><span class="arrow" aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class="hero-body wrap grid">
    <div class="hero-side" aria-hidden="true">
      <Seal size="clamp(4.5rem, 7vw, 7.5rem)" stamp />
      <p class="hero-vertical">{vertical}</p>
    </div>
    <div class="hero-main">
      <h1 id="hero-title" set:html={title} />
      <p class="hero-standfirst">{standfirst}</p>
      <p class="hero-actions">
        <a class="button" href={action.href}>{action.label} <span class="arrow" aria-hidden="true">→</span></a>
        {secondary && <a class="text-link" href={secondary.href}>{secondary.label}</a>}
      </p>
      {cards.length > 0 && (
        <ul class="hero-cards-phone">
          {cards.map((c) => (
            <li>
              <a class="corner-card" href={c.href}>
                <Picture src={plates[c.plate]} alt={c.alt} formats={['avif', 'webp']} widths={[320, 480]} sizes="46vw" style={`object-position:${focus[c.plate]}`} />
                <span class="corner-card-bar"><span>{c.title}</span><span class="arrow" aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
  <slot />
</section>

<script>
  // The signature move: the masthead turns slowly through the stations of the Tōkaidō.
  const root = document.querySelector<HTMLElement>('[data-masthead]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (root && !reduce.matches) {
    const items = [...root.querySelectorAll<HTMLElement>('.plate')];
    const caption = root.querySelector<HTMLElement>('[data-masthead-caption]');
    let index = 0;
    let timer: number | undefined;
    const advance = () => {
      items[index].classList.remove('is-active');
      index = (index + 1) % items.length;
      items[index].classList.add('is-active');
      if (caption) caption.textContent = items[index].dataset.caption ?? '';
    };
    const start = () => { if (!timer) timer = window.setInterval(advance, 6200); };
    const stop = () => { window.clearInterval(timer); timer = undefined; };
    if (items.length > 1) {
      start();
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    }
  }
</script>

<style>
  .masthead {
    position: relative;
    height: clamp(15rem, 41svh, 34rem);
    overflow: hidden;
    background: var(--paper-2);
  }
  .masthead-plates, .plate { position: absolute; inset: 0; }
  .plate :global(picture) { height: 100%; }
  .plate { opacity: 0; transition: opacity 1.6s var(--ease-in-out); }
  .plate.is-active { opacity: 1; }
  .plate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    .plate :global(img) { transform: scale(1.06); transition: transform 9s linear; }
    .plate.is-active :global(img) { transform: scale(1); }
  }
  .masthead-caption {
    position: absolute;
    left: var(--margin);
    bottom: var(--margin);
    max-width: min(34rem, calc(100% - 2 * var(--margin)));
    background: var(--paper);
    color: var(--ink);
    font-size: var(--step-small);
    line-height: 1.4;
    padding: 0.55rem 0.8rem;
  }
  .masthead-cards {
    position: absolute;
    right: var(--margin);
    bottom: var(--margin);
    display: flex;
    gap: 1rem;
  }
  .corner-card {
    display: block;
    width: 13.5rem;
    text-decoration: none;
    background: var(--paper);
    transition: transform var(--dur) var(--ease-out);
  }
  .corner-card :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .corner-card-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.75rem;
    font-size: var(--step-small);
    font-weight: 500;
    line-height: 1.3;
  }
  .corner-card-bar > span:first-child { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .corner-card:hover { transform: translateY(-4px); color: var(--ink); }
  .corner-card .arrow { transition: transform var(--dur) var(--ease-out); }
  .corner-card:hover .arrow { transform: translateX(3px); color: var(--shu); }

  .hero-body {
    padding-block: clamp(3rem, 6vw, 6rem) clamp(3rem, 6vw, 5.5rem);
    align-items: start;
  }
  .hero-side {
    grid-column: 1 / span 5;
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: flex-start;
    padding-top: 0.6rem;
  }
  .hero-vertical {
    writing-mode: vertical-rl;
    font-family: var(--font-jp);
    font-weight: 500;
    font-size: var(--step-lead);
    letter-spacing: 0.32em;
    line-height: 1;
    color: var(--ink);
  }
  .hero-main { grid-column: 6 / -1; }
  .hero-main h1 { font-size: var(--step-display); }
  :global(:root[lang='ja']) .hero-main h1 { max-width: 13em; font-size: clamp(2.2rem, 0.9rem + 4.6vw, 5.5rem); }
  .hero-standfirst {
    margin-top: clamp(1.5rem, 2.4vw, 2.25rem);
    font-size: var(--step-lead);
    line-height: 1.3;
    max-width: 42ch;
  }
  :global(:root[lang='ja']) .hero-standfirst { max-width: 30em; line-height: 1.7; font-size: clamp(1.1rem, 0.95rem + 0.6vw, 1.45rem); }
  .hero-actions {
    margin-top: clamp(1.75rem, 2.6vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  @media (max-width: 52rem) {
    .masthead-caption { bottom: auto; top: var(--margin); }
    .hero-side { grid-column: 1 / -1; order: 2; display: none; }
    .hero-main { grid-column: 1 / -1; }
  }
  .hero-cards-phone { display: none; }
  @media (max-width: 52rem) {
    .masthead-cards { display: none; }
    .hero-cards-phone { display: flex; gap: 0.6rem; margin-top: 2.5rem; max-width: 34rem; }
    .hero-cards-phone li { flex: 1 1 0; min-width: 0; }
    .hero-cards-phone .corner-card { width: 100%; background: var(--paper-2); }
  }
  @media (max-width: 40rem) {
    .masthead { height: clamp(14rem, 38svh, 20rem); }
    .masthead-caption { right: var(--margin); max-width: none; bottom: auto; top: var(--margin); }
    .corner-card-bar { padding-inline: 0.6rem; }
    .hero-main h1 { font-size: clamp(2.3rem, 10vw, 3rem); }
  }
</style>
