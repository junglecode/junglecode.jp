---
import { Image } from 'astro:assets';
import jet from '../assets/people/jet-villegas.jpg';
import aditya from '../assets/people/aditya-pandya.jpg';
import { PEOPLE } from '../data/config';

interface Person { key: string; name: string; bio: string; facts: string[]; link: string; portraitAlt: string }
interface Props {
  id: string;
  title: string;
  origin: string;
  people: Person[];
  builtAtLead: string;
  builtAt: string[];
  nameTitle: string;
  nameText: string;
  /** Japanese bios put the name inside the sentence, so the name is not repeated before them. */
  nameInBio?: boolean;
}
const { id, title, origin, people, builtAtLead, builtAt, nameTitle, nameText, nameInBio = false } = Astro.props;
const portraits = { jet, aditya } as const;
const tz = { jet: PEOPLE.jet.tz, aditya: PEOPLE.aditya.tz } as const;
---
<section class="team section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap grid team-head" data-reveal>
    <h2 id={`${id}-title`}>{title}</h2>
    <p class="team-origin">{origin}</p>
  </div>
  <div class="wrap team-people">
    {people.map((p) => (
      <article class="grid person" data-reveal>
        <ul class="person-facts">
          {p.facts.map((f, i) => <li>{f}{i === 0 && <> <span class="person-clock" data-clock={tz[p.key as 'jet' | 'aditya']}></span></>}</li>)}
          <li><a href={PEOPLE[p.key as 'jet' | 'aditya'].linkedin} rel="noopener">{p.link}</a></li>
        </ul>
        <p class="person-bio">
          <Image class="person-portrait" src={portraits[p.key as 'jet' | 'aditya']} alt={p.portraitAlt} width={360} height={360} densities={[1, 2]} />
          {!nameInBio && <strong>{p.name}</strong>} <span>{p.bio}</span>
        </p>
      </article>
    ))}
  </div>
  <div class="wrap grid team-built" data-reveal>
    <p class="built-lead">{builtAtLead}</p>
    <p class="built-list display">{builtAt.map((b, i) => <><span>{b}</span>{i < builtAt.length - 1 && <span class="built-sep" aria-hidden="true"> · </span>}</>)}</p>
  </div>
  <aside class="wrap grid team-name" id="about-the-name" aria-labelledby="about-the-name-title">
    <h3 id="about-the-name-title">{nameTitle}</h3>
    <p>{nameText}</p>
  </aside>
</section>

<style>
  .team-head { row-gap: 1.5rem; }
  .team-head h2 { grid-column: 1 / span 5; font-size: var(--step-head); max-width: 10ch; }
  .team-origin {
    grid-column: 6 / -1;
    font-family: var(--font-display);
    font-size: var(--step-lead);
    line-height: 1.25;
    max-width: 46ch;
  }
  :global(:root[lang='ja']) .team-origin { line-height: 1.7; max-width: 32em; }
  .team-people { margin-top: clamp(3.5rem, 7vw, 6rem); display: grid; gap: clamp(3.5rem, 6vw, 5.5rem); }
  .person { align-items: start; }
  .person-facts { display: grid; gap: 0.3rem; font-size: var(--step-small); line-height: 1.45; padding-top: 0.5rem; }
  .person:nth-child(odd) .person-bio { grid-column: 1 / span 8; }
  .person:nth-child(odd) .person-facts { grid-column: 10 / -1; grid-row: 1; }
  .person:nth-child(even) .person-facts { grid-column: 1 / span 3; grid-row: 1; }
  .person:nth-child(even) .person-bio { grid-column: 5 / -1; }
  .person-clock { color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .person-bio {
    font-family: var(--font-display);
    font-size: var(--step-lead);
    line-height: 1.3;
    max-width: 52ch;
  }
  :global(:root[lang='ja']) .person-bio { line-height: 1.8; max-width: 36em; }
  .person-bio strong { font-weight: 500; }
  .person-bio :global(.person-portrait) {
    float: left;
    width: 3.9em;
    height: 3.9em;
    object-fit: cover;
    margin: 0.25em 0.6em 0 0;
  }
  :global(:root[lang='ja']) .person-bio :global(.person-portrait) { width: 5.4em; height: 5.4em; margin-top: 0.45em; }
  .team-built { margin-top: clamp(4rem, 8vw, 7rem); row-gap: 1rem; align-items: baseline; }
  .built-lead { grid-column: 1 / span 5; font-size: var(--step-body); }
  .built-list {
    grid-column: 6 / -1;
    font-size: var(--step-lead);
    line-height: 1.3;
  }
  .built-sep { color: var(--shu); }
  .team-name {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    background: var(--paper-2);
    padding-block: 2rem;
    row-gap: 0.75rem;
  }
  .team-name h3 { grid-column: 1 / span 5; font-size: var(--step-lead); line-height: 1.1; }
  .team-name p { grid-column: 6 / -1; max-width: 58ch; }
  @media (min-width: 120rem) {
    .team-name { padding-inline: var(--margin); }
  }

  @media (max-width: 52rem) {
    .team-head h2, .team-origin, .built-lead, .built-list, .team-name h3, .team-name p { grid-column: 1 / -1; }
    .person:nth-child(n) .person-facts { grid-column: 1 / -1; grid-row: 2; grid-auto-flow: column; justify-content: start; gap: 1.25rem; margin-top: 1rem; }
    .person:nth-child(n) .person-bio { grid-column: 1 / -1; }
    .person-bio :global(.person-portrait) { width: 4.5em; height: 4.5em; }
  }
</style>
