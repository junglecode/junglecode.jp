---
// The founders, large and early: editorial portraits with their story.
import { Image } from 'astro:assets';
import jet from '../assets/people/jet-villegas.jpg';
import aditya from '../assets/people/aditya-pandya.jpg';
import { PEOPLE } from '../data/config';

interface Person { key: string; name: string; bio: string; facts: string[]; link: string; portraitAlt: string }
interface Props {
  id: string;
  label: string;
  headline: string;
  origin: string;
  people: Person[];
  nameTitle: string;
  nameText: string;
  localTime: string;
  /** Japanese bios put the name inside the sentence, so the name isn't repeated before them. */
  nameInBio?: boolean;
}
const { id, label, headline, origin, people, nameTitle, nameText, localTime, nameInBio = false } = Astro.props;
const portraits = { jet, aditya } as const;
---
<section class="team section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap grid team-head" data-reveal>
    <span class="label">{label}</span>
    <h2 id={`${id}-title`} class="h2">{headline}</h2>
    <p class="lead team-origin">{origin}</p>
  </div>
  <div class="wrap team-people">
    {people.map((p) => {
      const key = p.key as 'jet' | 'aditya';
      return (
        <article class="person">
          <figure class="person-photo" data-unmask>
            <Image src={portraits[key]} alt={p.portraitAlt} widths={[480, 720, 960]} sizes="(max-width: 52rem) 100vw, 44vw" />
          </figure>
          <div class="person-text" data-reveal>
            <h3>{p.name}</h3>
            <p class="person-meta"><span class="live" aria-hidden="true"></span>{p.facts[0]}, <span data-clock={PEOPLE[key].tz}></span> {localTime}</p>
            <p class="person-bio">{!nameInBio && <>{p.name} </>}{p.bio}</p>
            <p class="person-link"><a href={PEOPLE[key].linkedin} rel="noopener">{p.link}</a></p>
          </div>
        </article>
      );
    })}
  </div>
  <aside class="wrap grid team-name" aria-labelledby={`${id}-name-title`}>
    <h3 id={`${id}-name-title`}>{nameTitle}</h3>
    <p>{nameText}</p>
  </aside>
</section>

<style>
  .team-head { row-gap: 1rem; }
  .team-head .label, .team-head h2, .team-origin { grid-column: 1 / span 9; }
  .team-head h2 { max-width: 21ch; }
  .team-origin { color: var(--soft); max-width: 44ch; }
  :global(:root[lang='ja']) .team-head h2 { max-width: 14em; }
  .team-people { margin-top: clamp(3rem, 6vw, 5rem); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2.5rem, 4vw, 4rem) var(--gutter); }
  .person-photo { overflow: hidden; background: var(--surface); aspect-ratio: 4 / 5; }
  .person-photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease); }
  .person:hover .person-photo :global(img) { transform: scale(1.03); }
  .live { display: inline-block; width: 0.5rem; height: 0.5rem; margin-right: 0.5rem; border-radius: 999px; background: var(--signal); vertical-align: 0.05em; box-shadow: 0 0 0 0 var(--signal); }
  @media (prefers-reduced-motion: no-preference) { .live { animation: live 2.4s ease-out infinite; } }
  @keyframes live { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 70%, transparent); } 70%, 100% { box-shadow: 0 0 0 0.45rem transparent; } }
  .person-text { margin-top: 1.5rem; }
  .person-text h3 { font-size: var(--step-title); letter-spacing: -0.03em; }
  .person-meta { margin-top: 0.5rem; font-size: var(--step-small); color: var(--soft); }
  .person-bio { margin-top: 1rem; max-width: 52ch; }
  .person-link { margin-top: 1rem; font-size: var(--step-small); font-weight: 500; }
  .team-name { margin-top: clamp(4rem, 7vw, 6rem); padding-top: 1.5rem; border-top: 1px solid var(--rule); row-gap: 0.75rem; }
  .team-name h3 { grid-column: 1 / span 4; font-family: var(--font-text); font-size: 1rem; font-weight: 500; letter-spacing: 0; line-height: 1.5; }
  .team-name p { grid-column: 5 / span 7; color: var(--soft); max-width: 60ch; }
  @media (max-width: 52rem) {
    .team-head h2, .team-origin, .team-name h3, .team-name p { grid-column: 1 / -1; justify-self: start; }
    .team-people { grid-template-columns: 1fr; }
  }
</style>
