---
import Seal from './Seal.astro';
import { EMAIL } from '../data/config';
import type { SiteCopy } from '../data/en';

interface Props { copy: SiteCopy }
const { copy } = Astro.props;
const year = 2026;
---
<footer class="footer">
  <div class="wrap">
    <p class="footer-name" aria-hidden="true">JungleCode</p>
    <div class="footer-row grid">
      <ul class="footer-places">
        {copy.footer.places.map((p) => <li>{p}</li>)}
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      </ul>
      <div class="footer-cols">
        {copy.footer.columns.map((col) => (
          <nav aria-label={col.title}>
            <p class="footer-col-title">{col.title}</p>
            <ul>
              {col.links.map((l) => (
                <li><a href={l.href} lang={l.label === '日本語' ? 'ja' : l.label === 'English' ? 'en' : undefined}>{l.label}</a></li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>
    <div class="footer-legal">
      <p class="footer-copy"><Seal size="1.5rem" /> <span>{copy.footer.copyright(year)}</span></p>
      <p class="footer-credits">{copy.footer.credits}</p>
      <a class="footer-top" href="#main">{copy.footer.top}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--sumi);
    color: var(--on-sumi);
    padding-block: clamp(3rem, 6vw, 6rem) 2rem;
  }
  .footer a { color: inherit; }
  .footer a:hover { color: var(--shu); }
  .footer-name {
    font-family: 'Newsreader Variable', var(--font-display);
    font-weight: 500;
    font-size: clamp(3.4rem, 18.4vw, 22.5rem);
    line-height: 0.82;
    letter-spacing: -0.035em;
    margin-left: -0.04em;
    white-space: nowrap;
  }
  .footer-row { margin-top: clamp(3rem, 6vw, 4.5rem); row-gap: 3rem; }
  .footer-places { grid-column: 1 / span 5; display: grid; gap: 0.2rem; }
  .footer-places li {
    font-family: var(--font-display);
    font-size: var(--step-lead);
    line-height: 1.25;
    color: var(--shu-on-sumi);
  }
  .footer-places a { text-decoration: none; }
  .footer-places a:hover { color: var(--on-sumi); }
  .footer-cols {
    grid-column: 7 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
  }
  .footer-col-title { color: var(--on-sumi-soft); font-size: var(--step-small); margin-bottom: 0.6rem; }
  .footer-cols ul { display: grid; gap: 0.35rem; }
  .footer-cols a { font-size: var(--step-small); text-decoration: none; }
  .footer-cols a:hover { text-decoration: underline; }
  .footer-legal {
    margin-top: clamp(4rem, 7vw, 6rem);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: 1rem 2rem;
    font-size: var(--step-small);
    color: var(--on-sumi-soft);
  }
  .footer-copy { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--on-sumi); }
  .footer-credits { max-width: 62ch; }
  .footer-top { color: var(--on-sumi); }

  @media (max-width: 52rem) {
    .footer-places { grid-column: 1 / -1; }
    .footer-cols { grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2rem; }
    .footer-legal { grid-template-columns: 1fr auto; }
    .footer-credits { grid-column: 1 / -1; grid-row: 1; }
  }
</style>
