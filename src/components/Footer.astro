---
import { EMAIL } from '../data/config';
import type { SiteCopy } from '../data/en';

interface Props { copy: SiteCopy }
const { copy } = Astro.props;
const year = 2026;
// The email appears once per page: pages with a contact section or the privacy note already give it.
const path = Astro.url.pathname;
const showEmail = !/^\/(ja\/)?(healthcare\/|privacy\/)?$/.test(path);
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-row">
      <ul class="footer-places">
        {copy.footer.places.map((p) => <li>{p}</li>)}
        {showEmail && <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>}
      </ul>
      <div class="footer-cols">
        {copy.footer.columns.map((col) => (
          <nav aria-label={col.title}>
            <p class="footer-col-title">{col.title}</p>
            <ul>
              {col.links.map((l) => (
                <li><a href={l.href} lang={l.label === '日本語' ? 'ja' : l.label === 'English' ? 'en' : undefined}>{l.label}</a></li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>
    <div class="footer-guide" aria-hidden="true"><span class="guide"></span><span class="tile tile--dots is-lit"></span></div>
    <p class="footer-name" aria-hidden="true" data-arrive>{[...'JungleCode'].map((ch, i) => <span style={`--i:${i}`}>{ch}</span>)}</p>
    <div class="footer-legal">
      <p>{copy.footer.copyright(year)}</p>
      {copy.footer.credits && <p class="footer-credits">{copy.footer.credits}</p>}
      <a class="footer-top" href="#main">{copy.footer.top}</a>
    </div>
    <p class="footer-photos">
      {copy.footer.photoCredits.label}: {copy.footer.photoCredits.items.map((p, i) => <>{i > 0 && ' · '}<a href={p.href} rel="noopener">{p.what}</a>, {p.by}, <a href={p.licenceHref} rel="noopener license">{p.licence}</a></>)}
    </p>
  </div>
</footer>

<style>
  .footer { background: var(--bg); padding-top: clamp(4rem, 8vw, 7rem); border-top: 1px solid var(--rule); }
  .footer-row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2.5rem var(--gutter); }
  .footer-places { grid-column: 1 / span 5; display: grid; gap: 0.15rem; }
  .footer-places li { font-family: var(--font-display); font-size: var(--step-title); line-height: 1.2; letter-spacing: -0.025em; }
  .footer-places a { text-decoration-color: transparent; }
  .footer-places a:hover { text-decoration-color: currentColor; }
  .footer-cols { grid-column: 7 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gutter); }
  .footer-col-title { font-size: var(--step-small); color: var(--soft); margin-bottom: 0.75rem; }
  .footer-cols ul { display: grid; gap: 0.4rem; }
  .footer-cols a { text-decoration-color: transparent; }
  .footer-cols a:hover { text-decoration-color: currentColor; }
  .footer-guide { margin-top: clamp(4rem, 8vw, 7rem); display: flex; gap: 2px; }
  .footer-guide .guide { flex: 1; }
  .footer-guide .tile { --tile: 1.75rem; }
  .footer-name {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.4rem, 18.8vw, 21rem);
    line-height: 0.8;
    letter-spacing: -0.055em;
    white-space: nowrap;
    margin-left: -0.03em;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .footer-name span { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .footer-name span { transform: translateY(100%); transition: transform 1.1s var(--ease); transition-delay: calc(var(--i) * 45ms); }
    :global(.js) .footer-name:global(.is-in) span { transform: none; }
  }
  .footer-legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 2rem; padding-block: 2rem 2.5rem; font-size: var(--step-small); color: var(--soft); }
  .footer-credits { max-width: 60ch; }
  .footer-top { color: var(--ink); }
  .footer-photos { padding-bottom: 1.5rem; margin-top: -1rem; font-size: 0.75rem; line-height: 1.5; color: var(--soft); }
  .footer-photos a { text-decoration-color: transparent; }
  .footer-photos a:hover { text-decoration-color: currentColor; }
  @media (max-width: 52rem) {
    .footer-places, .footer-cols { grid-column: 1 / -1; }
    .footer-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2rem; }
  }
</style>
