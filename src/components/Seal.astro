---
// The JungleCode hanko: a square vermilion seal reading ジャングルコード in two columns,
// right to left, the way a katakana seal is carved for someone working in Japan.
// `chars` lets the route map reuse the seal for two-character station stamps.
interface Props {
  size?: string;
  chars?: string;
  label?: string;
  class?: string;
  stamp?: boolean;
}
const { size = '2.5rem', chars, label, class: className = '', stamp = false } = Astro.props;

const name = ['ジ', 'ャ', 'ン', 'グ', 'ル', 'コ', 'ー', 'ド'];
// Small kana sit up and to the right in vertical writing. The long-vowel mark turns upright.
const tweak: Record<string, string> = {
  'ャ': 'translate(3.2 -3.6) scale(0.86)',
  'ー': 'rotate(90)',
};
const id = `seal-${Math.random().toString(36).slice(2, 8)}`;
const pair = chars ? [...chars] : null;
---
<svg
  class:list={['seal', className, { 'seal--stamp': stamp }]}
  style={`--seal-size:${size}`}
  viewBox="0 0 100 100"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <defs>
    <filter id={`${id}-ink`} x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.2" />
    </filter>
  </defs>
  <g filter={`url(#${id}-ink)`}>
    <rect x="4" y="4" width="92" height="92" rx="3" class="seal-ground" />
    <rect x="10.5" y="10.5" width="79" height="79" rx="1.5" class="seal-frame" />
    {pair ? (
      <g class="seal-chars seal-chars--pair">
        <text x="50" y="31.5" text-anchor="middle" dominant-baseline="central">{pair[0]}</text>
        <text x="50" y="68.5" text-anchor="middle" dominant-baseline="central">{pair[1]}</text>
      </g>
    ) : (
      <g class="seal-chars">
        {name.map((ch, i) => {
          const col = i < 4 ? 66 : 34;
          const row = 22 + (i % 4) * 18.6;
          return (
            <text
              x="0"
              y="0"
              text-anchor="middle"
              dominant-baseline="central"
              transform={`translate(${col} ${row}) ${tweak[ch] ?? ''}`}
            >{ch}</text>
          );
        })}
      </g>
    )}
  </g>
</svg>

<style>
  .seal {
    width: var(--seal-size);
    height: var(--seal-size);
    flex: none;
    overflow: visible;
    transform: rotate(-2deg);
  }
  .seal-ground { fill: var(--shu); }
  .seal-frame { fill: none; stroke: var(--on-shu); stroke-width: 2.6; }
  .seal-chars text {
    fill: var(--on-shu);
    font-family: 'Shippori Mincho B1', 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    font-weight: 800;
    font-size: 17px;
  }
  .seal-chars--pair text { font-size: 31px; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .seal--stamp { opacity: 0; transform: rotate(-9deg) scale(1.32); }
    :global(.js) .seal--stamp.is-stamped {
      opacity: 1;
      transform: rotate(-2deg) scale(1);
      transition: opacity 180ms ease-out, transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
  }
</style>
