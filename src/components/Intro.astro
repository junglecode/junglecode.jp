---
// Lead line over four columns: who, what, where, how to reach us.
interface Props {
  lead: string;
  columns: { runIn: string; text: string; link?: { label: string; href: string } }[];
}
const { lead, columns } = Astro.props;
---
<div class="intro wrap" data-reveal>
  <p class="intro-lead">{lead}</p>
  <div class="intro-cols">
    {columns.map((c) => (
      <p>
        <strong>{c.runIn}</strong> {c.text}{c.link && <> <a href={c.link.href}>{c.link.label}</a></>}
      </p>
    ))}
  </div>
</div>

<style>
  .intro { padding-bottom: var(--section); }
  .intro-lead {
    font-family: var(--font-display);
    font-size: var(--step-lead);
    line-height: 1.22;
    letter-spacing: -0.005em;
    max-width: 62ch;
  }
  :global(:root[lang='ja']) .intro-lead { line-height: 1.7; max-width: 42em; letter-spacing: 0.02em; }
  .intro-cols {
    margin-top: clamp(3rem, 5vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem var(--gutter);
    align-items: start;
  }
  .intro-cols p { line-height: 1.55; max-width: 34ch; }
  .intro-cols strong { font-weight: 500; }
  @media (max-width: 64rem) {
    .intro-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 40rem) {
    .intro-cols { grid-template-columns: 1fr; gap: 1.75rem; }
  }
</style>
