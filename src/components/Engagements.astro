---
// Three ways to work together, as editorial rows. The Readiness Sprint opens to show its four weeks.
import { Image } from 'astro:assets';
import jet from '../assets/people/jet-villegas-avatar.jpg';
import aditya from '../assets/people/aditya-pandya-avatar.jpg';

interface Tile { key: string; name: string; figure: string; who: string; lines: string[]; cta: string }
interface Session { day: string; title: string; note: string; people: string[] }
interface Week { tab: string; label: string; sessions: Session[] }
interface Props {
  id: string;
  label: string;
  title: string;
  tiles: Tile[];
  note: string;
  ctaHref: string;
  sprintToggle: string;
  weeks: Week[];
  sprintNote: string;
  youLabel: string;
  names: { jet: string; aditya: string };
}
const { id, label, title, tiles, note, ctaHref, sprintToggle, weeks, sprintNote, youLabel, names } = Astro.props;
const faces = { jet, aditya } as const;
---
<section class="engage section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap engage-head" data-reveal>
    <span class="label">{label}</span>
    <h2 id={`${id}-title`} class="h2">{title}</h2>
  </div>
  <ol class="wrap engage-rows">
    {tiles.map((t) => (
      <li class="row" data-reveal>
        <div class="row-name">
          <h3>{t.name}</h3>
          <p class="row-figure">{t.figure}</p>
        </div>
        <p class="row-who">{t.who}</p>
        <ul class="row-lines">{t.lines.map((l) => <li>{l}</li>)}</ul>
        <a class="row-cta" href={ctaHref} data-engagement-cta={t.name}>{t.cta} <span aria-hidden="true">→</span></a>
        {t.key === 'sprint' && (
          <details class="row-weeks">
            <summary>{sprintToggle}<span class="toggle" aria-hidden="true"></span></summary>
            <div class="weeks">
              {weeks.map((w) => (
                <div class="week">
                  <p class="week-head"><span>{w.tab}</span> <strong>{w.label}</strong></p>
                  <ul>
                    {w.sessions.map((s) => (
                      <li>
                        <span class="s-day">{s.day}</span>
                        <span class="s-what"><span class="s-title">{s.title}</span><span class="s-note">{s.note}</span></span>
                        <span class="s-people" aria-label={s.people.map((p) => (p === 'you' ? youLabel : names[p as 'jet' | 'aditya'])).join(', ')}>
                          {s.people.map((p) => p === 'you'
                            ? <span class="face face--you" aria-hidden="true">{youLabel}</span>
                            : <Image class="face" src={faces[p as 'jet' | 'aditya']} alt="" width={56} height={56} />)}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <p class="weeks-note">{sprintNote}</p>
          </details>
        )}
      </li>
    ))}
  </ol>
  <div class="wrap"><p class="engage-note">{note}</p></div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-engagement-cta]').forEach((a) => {
    a.addEventListener('click', () => document.dispatchEvent(new CustomEvent('jc:engagement', { detail: a.dataset.engagementCta })));
  });
</script>

<style>
  .engage-head { display: grid; gap: 1rem; }
  .engage-head h2 { max-width: 20ch; }
  :global(:root[lang='ja']) .engage-head h2 { max-width: 16em; }
  .engage-rows { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 3fr) minmax(0, 4fr) 13rem;
    gap: 1.25rem var(--gutter);
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
    border-top: 1px solid var(--rule);
    align-items: start;
    position: relative;
  }
  .row::before { content: ''; position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: var(--signal); transform: scaleX(0); transform-origin: 0 50%; transition: transform 700ms var(--ease); }
  .row:hover::before, .row:focus-within::before { transform: none; }
  .row:last-child { border-bottom: 1px solid var(--rule); }
  .row-name h3 { font-size: var(--step-title); letter-spacing: -0.035em; }
  :global(:root[lang='ja']) .row-name h3 { letter-spacing: -0.02em; }
  .row-figure { margin-top: 0.6rem; font-weight: 500; }
  .row-who { color: var(--soft); max-width: 30ch; padding-top: 0.5rem; }
  .row-lines { display: grid; gap: 0.35rem; padding-top: 0.5rem; }
  .row-lines li { padding-left: 1.1rem; position: relative; }
  .row-lines li::before { content: ''; position: absolute; left: 0; top: 0.72em; width: 0.45rem; height: 1px; background: var(--soft); }
  .row-cta { padding-top: 0.5rem; font-weight: 500; text-decoration-color: transparent; justify-self: end; text-align: right; }
  .row-cta span { display: inline-block; transition: transform var(--dur) var(--ease); }
  .row-cta:hover { text-decoration-color: currentColor; }
  .row-cta:hover span { transform: translateX(4px); }
  .row-weeks { grid-column: 1 / -1; margin-top: 0.5rem; }
  .row-weeks summary { cursor: pointer; font-weight: 500; width: fit-content; list-style: none; display: inline-flex; align-items: center; gap: 0.75rem; line-height: 1.3; }
  .row-weeks summary::-webkit-details-marker { display: none; }
  /* A drawn plus, so it sits dead centre whatever the font's metrics */
  .toggle { position: relative; flex: none; width: 1.75rem; height: 1.75rem; border: 1px solid var(--rule); border-radius: 999px; transition: transform var(--dur) var(--ease), background-color var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .toggle::before, .toggle::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.7rem; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); }
  .toggle::after { transform: translate(-50%, -50%) rotate(90deg); }
  .row-weeks summary:hover .toggle { background: var(--signal); border-color: var(--signal); color: var(--signal-ink); }
  .row-weeks[open] .toggle { transform: rotate(45deg); }
    .weeks { margin-top: 1.5rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem var(--gutter); }
  .week { background: var(--surface); padding: 1.25rem; border-radius: var(--radius); }
  .week-head span { display: block; font-size: var(--step-small); color: var(--soft); }
  .week-head strong { font-family: var(--font-display); font-weight: 400; font-size: var(--step-subtitle); letter-spacing: -0.02em; }
  .week ul { margin-top: 1rem; display: grid; gap: 1rem; }
  .week li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 0.35rem 0.5rem; align-items: baseline; }
  .s-day { font-size: var(--step-small); color: var(--soft); }
  .s-what { display: grid; gap: 0.1rem; }
  .s-title { font-weight: 500; font-size: 0.9375rem; line-height: 1.35; }
  .s-note { font-size: var(--step-small); color: var(--soft); line-height: 1.4; }
  .s-people { grid-column: 2; display: flex; }
  .s-people > :global(*) + :global(*) { margin-left: -6px; }
  .s-people :global(.face) { width: 1.6rem; height: 1.6rem; border-radius: 999px; object-fit: cover; box-shadow: 0 0 0 2px var(--surface); }
  .face--you { display: inline-grid; place-items: center; background: var(--signal); color: var(--signal-ink); font-size: 0.6875rem; font-weight: 500; }
  .weeks-note { margin-top: 1rem; font-size: var(--step-small); color: var(--soft); }
  .engage-note { margin-top: 2rem; color: var(--soft); max-width: 70ch; }
  @media (max-width: 64rem) {
    .row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .row-cta { grid-column: 1 / -1; justify-self: start; text-align: left; }
    .weeks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 40rem) {
    .row { grid-template-columns: 1fr; }
    .weeks { grid-template-columns: 1fr; }
  }
</style>
