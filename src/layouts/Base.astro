---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL } from '../data/config';
import type { SiteCopy } from '../data/en';

interface Props {
  copy: SiteCopy;
  title: string;
  description: string;
  /** Path of this page in English, e.g. "/healthcare/". The Japanese path is derived from it. */
  enPath: string;
  navLinks?: { label: string; href: string }[];
  noindex?: boolean;
  /** When false the page has no Japanese counterpart, so the switch goes to the Japanese home. */
  hasJa?: boolean;
  ogType?: 'website' | 'article';
}
const { copy, title, description, enPath, navLinks, noindex = false, hasJa = true, ogType = 'website' } = Astro.props;

const jaPath = enPath === '/' ? '/ja/' : `/ja${enPath}`;
const selfPath = copy.locale === 'ja' ? jaPath : enPath;
const otherPath = copy.locale === 'ja' ? enPath : hasJa ? jaPath : '/ja/';
const canonical = new URL(selfPath, SITE_URL).href;
const ogImage = new URL(copy.locale === 'ja' ? '/og-ja.jpg' : '/og.jpg', SITE_URL).href;
---
<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hasJa && <link rel="alternate" hreflang="en" href={new URL(enPath, SITE_URL).href} />}
    {hasJa && <link rel="alternate" hreflang="ja" href={new URL(jaPath, SITE_URL).href} />}
    {hasJa && <link rel="alternate" hreflang="x-default" href={new URL(enPath, SITE_URL).href} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="JungleCode" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={copy.locale === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f1efec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
    {copy.locale === 'ja' && <link rel="preload" href="/fonts/shippori-mincho-b1-subset-800.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href="/fonts/shippori-mincho-b1-subset-500.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      // ?theme=light or ?theme=dark pins the palette, for review and screenshots.
      try { const t = new URLSearchParams(location.search).get('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skip}</a>
    <Nav copy={copy} links={navLinks} switchHref={otherPath} />
    <main id="main">
      <slot />
    </main>
    <Footer copy={copy} />
    <script>
      // Section entrances: each [data-reveal] block staggers its children in once.
      // Content is in the document from the first paint, so nothing depends on this firing.
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            entry.target.querySelectorAll('.seal--stamp:not(.station-seal)').forEach((s) => s.classList.add('is-stamped'));
            reveal.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => reveal.observe(el));

      // Stamps outside reveal blocks press in as they arrive. The route map stamps its own
      // stations as the line reaches them, so its seals are left out here.
      const stamps = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-stamped');
            stamps.unobserve(entry.target);
          }
        },
        { threshold: 0.6 },
      );
      document.querySelectorAll('.seal--stamp:not([data-reveal] .seal--stamp):not(.station-seal)').forEach((el) => stamps.observe(el));

      // Local times for Tokyo and New York, refreshed each minute.
      const clocks = document.querySelectorAll<HTMLElement>('[data-clock]');
      const tick = () => {
        const now = new Date();
        clocks.forEach((el) => {
          el.textContent = new Intl.DateTimeFormat(document.documentElement.lang === 'ja' ? 'ja-JP' : 'en-US', {
            hour: 'numeric',
            minute: '2-digit',
            timeZone: el.dataset.clock,
          }).format(now);
        });
      };
      if (clocks.length) {
        tick();
        setInterval(tick, 30_000);
      }
    </script>
  </body>
</html>
