---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { photos, focus, type PhotoKey } from '../components/Photos';
import { en } from '../data/en';
import { ja } from '../data/ja';
const n = en.notFound;
---
<Base copy={en} title={n.meta.title} description={n.meta.description} enPath="/404/" hasJa={false} noindex>
  <section class="lost section wrap" aria-labelledby="lost-title">
    <div class="lost-text" data-reveal>
      <h1 id="lost-title">{n.title}</h1>
      <p class="lead">{n.text}</p>
      <p lang="ja" class="lost-ja">{ja.notFound.text}</p>
      <p class="lost-actions">
        <a class="button" href="/">{n.home} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="text-link" href="/ja/" lang="ja">{ja.notFound.home}</a>
      </p>
    </div>
    <nav class="lost-links" aria-labelledby="lost-links-title">
      <h2 id="lost-links-title" class="label">{n.pick}</h2>
      <ul>
        {n.stations.map((s) => (
          <li data-reveal>
            <a href={s.href}>
              <Picture src={photos[s.photo as PhotoKey]} alt="" formats={['avif', 'webp']} widths={[400, 640]} sizes="(max-width: 52rem) 50vw, 24vw" style={`object-position:${focus[s.photo as PhotoKey]}`} />
              <span>{s.label} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
</Base>

<style>
  .lost-text { display: grid; gap: 1.25rem; max-width: 46rem; }
  .lost-text h1 { font-size: var(--step-display); }
  .lost-text .lead { color: var(--soft); }
  .lost-ja { font-family: 'Noto Serif JP', 'Hiragino Mincho ProN', serif; color: var(--soft); }
  .lost-actions { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; margin-top: 0.5rem; }
  .lost-links { margin-top: clamp(4rem, 8vw, 6rem); }
  .lost-links ul { margin-top: 1rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); }
  .lost-links a { display: grid; gap: 0.75rem; text-decoration: none; font-weight: 500; }
  .lost-links :global(picture) { overflow: hidden; }
  .lost-links :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; transition: transform 1.2s var(--ease); }
  .lost-links a:hover :global(img) { transform: scale(1.04); }
  @media (max-width: 52rem) { .lost-links ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
